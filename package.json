{
  "name": "defencore-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0 --port 8081",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "npm run validate:content && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
